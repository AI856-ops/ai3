def direct_answer(question):
    q = question.lower().strip()
    q = re.sub(r"[?!.,]+", "", q)
    q = re.sub(r"\s+", " ", q)

    # DIRECT ANSWERS
    answers = [
        (["capital of algeria", "capital city of algeria"],
         "The capital of Algeria is Algiers! 🇩🇿"),

        (["capital of france"],
         "The capital of France is Paris! 🇫🇷"),

        (["capital of canada"],
         "The capital of Canada is Ottawa! 🇨🇦"),

        (["capital of japan"],
         "The capital of Japan is Tokyo! 🇯🇵"),

        (["capital of the united states", "capital of america"],
         "The capital of the United States is Washington, D.C.! 🇺🇸"),

        (["capital of australia"],
         "The capital of Australia is Canberra! 🇦🇺"),

        (["capital of morocco"],
         "The capital of Morocco is Rabat! 🇲🇦"),

        (["capital of tunisia"],
         "The capital of Tunisia is Tunis! 🇹🇳"),

        (["capital of egypt"],
         "The capital of Egypt is Cairo! 🇪🇬"),

        (["capital of italy"],
         "The capital of Italy is Rome! 🇮🇹"),

        (["capital of spain"],
         "The capital of Spain is Madrid! 🇪🇸"),

        (["capital of germany"],
         "The capital of Germany is Berlin! 🇩🇪"),

        (["capital of the united kingdom", "capital of england"],
         "The capital of the United Kingdom is London! 🇬🇧"),

        (["capital of china"],
         "The capital of China is Beijing! 🇨🇳"),

        (["capital of india"],
         "The capital of India is New Delhi! 🇮🇳"),

        (["capital of brazil"],
         "The capital of Brazil is Brasília! 🇧🇷"),

        (["capital of mexico"],
         "The capital of Mexico is Mexico City! 🇲🇽"),

        (["color of a banana", "colour of a banana",
          "what color is a banana", "what colour is a banana"],
         "A banana is usually yellow! 🍌"),

        (["color of the sky", "colour of the sky",
          "what color is the sky", "what colour is the sky"],
         "The sky often looks blue during the day! 🌤️"),

        (["color of grass", "colour of grass"],
         "Grass is usually green! 🌱"),

        (["color of snow", "colour of snow"],
         "Snow usually looks white! ❄️"),

        (["how many days are in a week"],
         "There are 7 days in a week! 📅"),

        (["how many months are in a year"],
         "There are 12 months in a year! 📅"),

        (["how many legs does a spider have"],
         "A spider has 8 legs! 🕷️"),

        (["how many legs does a dog have"],
         "A typical dog has 4 legs! 🐶"),

        (["what is 2 plus 2", "what is 2+2"],
         "2 + 2 = 4! 🧠")
    ]

    for patterns, answer in answers:
        for pattern in patterns:
            if pattern in q:
                return answer

    # SIMPLE MATH
    math_match = re.fullmatch(
        r"\s*(-?\d+(?:\.\d+)?)\s*([+*/-])\s*"
        r"(-?\d+(?:\.\d+)?)\s*", q
    )

    if math_match:
        a = float(math_match.group(1))
        operator = math_match.group(2)
        b = float(math_match.group(3))

        try:
            if operator == "+":
                result = a + b
            elif operator == "-":
                result = a - b
            elif operator == "*":
                result = a * b
            else:
                result = a / b

            if result == int(result):
                result = int(result)

            return "The answer is " + str(result) + "! 🧠"

        except ZeroDivisionError:
            return "You can't divide by zero!"

    return None


def search_wikipedia(question):
    # SEARCH THE ORIGINAL QUESTION FIRST
    params = urllib.parse.urlencode({
        "action": "query",
        "list": "search",
        "srsearch": question,
        "format": "json",
        "srlimit": 5
    })

    data = get_json(WIKIPEDIA_API + "?" + params)
    results = data.get("query", {}).get("search", [])

    if not results:
        print("Nyvexia IA: Sorry, I couldn't find a result! 😭")
        return

    # GET THE BEST AVAILABLE SEARCH RESULT
    title = results[0]["title"]

    details_params = urllib.parse.urlencode({
        "action": "query",
        "prop": "extracts",
        "explaintext": 1,
        "exintro": 1,
        "exchars": 1500,
        "titles": title,
        "format": "json"
    })

    details = get_json(WIKIPEDIA_API + "?" + details_params)
    pages = details.get("query", {}).get("pages", {})
    page = next(iter(pages.values()), {})
    answer = page.get("extract", "").strip()

    answer = re.sub(r"\s+", " ", html.unescape(answer))

    # SHOW MORE THAN ONE SENTENCE FOR USEFUL CONTEXT
    sentences = re.split(r"(?<=[.!?])\s+", answer)
    short_answer = " ".join(sentences[:3])

    print("\n" + random.choice([
        "NYVEXIA IA: HERE'S WHAT I FOUND! 🔥",
        "NYVEXIA IA: CHECK THIS OUT! 🚀",
        "NYVEXIA IA: LET'S GET INTO IT! 🧠",
        "NYVEXIA IA: LOOK WHAT I DISCOVERED! 👀",
        "NYVEXIA IA: HERE'S THE INFORMATION! ⚡"
    ]))

    if short_answer:
        print("\n" + short_answer)
    else:
        print("\nI found a page, but couldn't get a summary.")

    print("\nSOURCE LINKS 🔗")

    for number, item in enumerate(results[:3], 1):
        article = urllib.parse.quote(
            item["title"].replace(" ", "_")
        )
        print(str(number) + ". " + item["title"])
        print("https://en.wikipedia.org/wiki/" + article)

    print("\n" + random.choice([
        "What else do you want to know? 😎",
        "Got another question? 🚀",
        "Let's explore something else! 🔥",
        "Your turn! What's next? 🧠"
    ]))


